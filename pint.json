{
    "preset": "laravel",
    "rules": {
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "declare_strict_types": false,
        "no_superfluous_phpdoc_tags": {
            "allow_mixed": false,
            "remove_inheritdoc": true
        },
        "phpdoc_align": {
            "align": "left"
        },
        "single_line_throw": false
    }
}
